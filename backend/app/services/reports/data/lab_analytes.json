      "aliases": ["haemoglobin", "hb", "hgb", "haemoglobin (hb)", "hemoglobin (hb)"],
      "unit": "g/dL",
      "unit_aliases": ["g/dl", "gm/dl", "g / dl", "gms/dl", "g%"]
    },
    "wbc": {
      "display": "White blood cells",
