# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Environment / secrets
.env
.env.*
!.env.example

# Uploaded medical reports — never commit. Anchored with a leading slash so
# the rule cannot also swallow source directories named `storage`, such as
# backend/app/services/storage/.
/storage/
/backend/storage/

# Editors / OS / local tooling
.DS_Store
.idea/
.vscode/
.claude/
*.swp

# ML — raw data and build outputs. Reports and metadata ARE committed so the
# evaluation can be reviewed without retraining.
ml/data/
ml/artifacts/*.joblib

# Logs
*.log
