# ---------------------------------------------------------------------------
# MedAnalyser — example environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Variables are consumed by the backend (pydantic-settings) and docker compose.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=MedAnalyser
ENVIRONMENT=development           # development | test | production
DEBUG=true
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
API_PREFIX=/api

# --- Database ---------------------------------------------------------------
# Async driver (used by the application at runtime).
DATABASE_URL=postgresql+asyncpg://medanalyser:medanalyser@localhost:5432/medanalyser
# Individual parts, used by docker compose to provision the Postgres container.
POSTGRES_USER=medanalyser
POSTGRES_PASSWORD=medanalyser
POSTGRES_DB=medanalyser
POSTGRES_PORT=5432

# --- Security / Auth (used from Phase 2 onwards) -----------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Machine learning ------------------------------------------------------
# MedAnalyser's core intelligence is a locally trained scikit-learn model.
# No external or paid AI API is used. Produce the artifacts with:
#     python -m ml.training.train_condition_model
ML_ARTIFACTS_PATH=./ml/artifacts
CONDITION_MODEL_NAME=condition_model
# Refuse to start without a trained model. Leave false in development.
ML_REQUIRE_MODEL=false

# --- File storage (used from Phase 5 onwards) --------------------------------
STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20

# --- Doctor discovery (used from Phase 9 onwards) ----------------------------
DOCTOR_PROVIDER=mock
MAPS_API_KEY=

# --- Frontend (Vite) ---------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Never put a secret here.
VITE_API_BASE_URL=http://localhost:8000
