# Frontend environment (Vite).
# Only VITE_-prefixed variables reach browser code. NEVER put a secret here —
# everything in this file is shipped to the client.

# Base URL of the MedAnalyser API. Leave empty to use the dev server proxy
# (recommended in development: keeps the browser same-origin so the httpOnly
# refresh cookie is sent).
VITE_API_BASE_URL=

# Target the dev server proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:8000

# Google OAuth *client id*. This is public by design and safe to ship.
# The client SECRET must only ever live in the backend environment.
# Leave empty to disable the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
